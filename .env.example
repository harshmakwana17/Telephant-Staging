# Copy this file to .env.local:   cp .env.example .env.local
#
# The values below are safe to commit. Sanity project IDs are public by design -
# this one already appears in every image URL on the live site. Access is
# controlled by project membership and CORS, not by keeping the ID hidden.

# Sanity ---------------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=1809di1b
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Local only. Do NOT set this on Vercel - there the domain resolves itself.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secrets --------------------------------------------------------------------
# Leave these empty. Never commit real values; .env.local is gitignored.

# Only needed if you point a Sanity webhook at /api/revalidate.
SANITY_REVALIDATE_SECRET=

# Only needed to run `npm run seed`. Not required for development or editing.
SANITY_WRITE_TOKEN=
